# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.bak

# Model weights — multi-GB, fetched separately via scripts
checkpoints/

# Claude Code local state (scheduler lock etc.)
.claude/

# Work-process scratch — internal planning/process notes, not release artifacts.
# LEARNING_WORK_ORDER is the observation-learning work order (reveals workflow);
# archive/ holds transient progress notes (_publish_resume, _stage9_status, …).
# Public surface stays README/NOTICE + LEARNING_LOG/ + out/audit_manual_v_t/.
LEARNING_WORK_ORDER_Lance_MLX_v2.md
archive/

# Logs
*.log

# Intermediate outputs — most are dev artifacts (raw fixtures, PNG, logs).
# Use `out/*` (direct children only, NOT recursive) so the `!` re-includes
# below work — git cannot re-include a path whose *parent dir* is excluded,
# so we must NOT blanket-ignore `out/` itself.
out/*

# Public release: curated byte-level evidence behind the verification claims.
!out/audit_manual_v_t/
!out/lance_3b_mlx/
out/lance_3b_mlx/*
!out/lance_3b_mlx/metadata.json
!out/lance_3b_video_mlx/
out/lance_3b_video_mlx/*
!out/lance_3b_video_mlx/metadata.json
# STAGE 11 non-blind re-verification run-records (referenced by README).
!out/stage11_x2t_verify.json
!out/stage11_ti2i_velocity_verify.json
!out/stage11_video_edit_verify.json

# Nested git directories under refs/ (upstream PT repos) — keep their files,
# drop their git history (`refs/Lance/.git/pack/*.pack` alone is ~99MB).
refs/**/.git/
refs/**/.git
